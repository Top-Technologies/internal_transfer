<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_store_issue_voucher" model="report.paperformat">
        <field name="name">Store Issue Voucher</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_store_issue_voucher" model="ir.actions.report">
        <field name="name">Store Issue Voucher</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">internal_transfer.report_store_issue_voucher</field>
        <field name="report_file">internal_transfer.report_store_issue_voucher</field>
        <field name="print_report_name">'Store Issue Voucher - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_store_issue_voucher"/>
    </record>
</odoo>
