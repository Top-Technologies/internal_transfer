<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Not done: Product / Ordered / Delivered / Cost -->
    <template id="report_delivery_document_cost" inherit_id="stock.report_delivery_document">
        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_quantity']" position="after">
            <th name="th_sm_cost" class="text-end"><strong>Cost</strong></th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[last()]" position="after">
            <td class="text-end">
                <span t-esc="move.product_uom_qty * (move.product_id.list_price or 0.0)"
                      t-options="{'widget': 'float', 'precision': 2}"/>
            </td>
        </xpath>

        <!-- Done state header -->
        <xpath expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_quantity']" position="after">
            <th name="th_sml_cost" class="text-center">Cost</th>
        </xpath>
    </template>

    <!-- Done: aggregated lines Cost = Ordered qty × Sales Price -->
    <template id="stock_report_delivery_aggregated_move_lines_cost" inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//td[@name='move_line_aggregated_quantity']" position="after">
            <td class="text-center" name="move_line_aggregated_cost">
                <span t-esc="(aggregated_lines[line]['qty_ordered'] or 0.0) * (aggregated_lines[line]['product'].list_price or 0.0)"
                      t-options="{'widget': 'float', 'precision': 2}"/>
            </td>
        </xpath>
    </template>

    <!-- Done: serial/lot lines Cost = line qty × Sales Price -->
    <template id="stock_report_delivery_has_serial_move_line_cost" inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//td[@name='move_line_lot_quantity']" position="after">
            <td class="text-center" name="move_line_lot_cost">
                <span t-esc="move_line.quantity * (move_line.product_id.list_price or 0.0)"
                      t-options="{'widget': 'float', 'precision': 2}"/>
            </td>
        </xpath>
    </template>
</odoo>
